Package: gpsd-clients
Version: 3.25-r1
Depends: libc, libusb-1.0-0, libncurses6
Source: feeds/openmanet/utils/gpsd
SourceName: gpsd
License: BSD-3-Clause
LicenseFiles: COPYING
